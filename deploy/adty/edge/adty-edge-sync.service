[Unit]
Description=Sync ADTY AI mainland edge Nginx certificates and routing manifest
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/adtyai/edge.env
ExecStart=/usr/bin/python3 /opt/adtyai-edge/sync-edge.py
TimeoutStartSec=180s
NoNewPrivileges=yes
PrivateTmp=yes
