# ADTY AI 香港边缘节点同步配置，复制到 /etc/adtyai/edge.env 并 chmod 600。

# 源站内部清单接口地址（使用回源域名 origin.adtyaicf.top 或主站域名）
ORIGIN_MANIFEST_URL=https://origin.adtyaicf.top/api/adty/internal/edge/manifest

# 源站服务器真实公网 IP（必填，直连源站 443，绕过 Cloudflare，同时以 URL 主机名作为 TLS SNI）
ORIGIN_CONNECT_IP=

# 校验源站 Cloudflare Origin CA 证书的根证书路径（从 Cloudflare 文档下载 Origin CA Root RSA PEM）
ORIGIN_CA_FILE=/etc/nginx/adty-edge/cloudflare-origin-ca.pem

# 与源站 .env 中 ADTY_EDGE_TOKEN 完全一致（openssl rand -hex 32）
EDGE_TOKEN=

# 边缘 Nginx 生成配置目录（默认 /etc/nginx/adty-edge）
EDGE_CONF_DIR=/etc/nginx/adty-edge
NGINX_BIN=nginx
NGINX_RELOAD_CMD=systemctl reload nginx
CERT_RETENTION_DAYS=7

# 可选：裸域本地 301 跳转（80 端口 HTTP-01 自动签发与续期，不碰 Cloudflare _acme-challenge DNS）
# APEX_REDIRECT_HOST=adtyai.com
# APEX_REDIRECT_TARGET=https://www.adtyai.com
# APEX_ACME_EMAIL=
